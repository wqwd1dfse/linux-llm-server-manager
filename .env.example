# ==========================================
# Linux / LLM Server Manager Configuration
# ==========================================

# Network Binding
# Default is 127.0.0.1 for security. Change to 0.0.0.0 only if behind a secure firewall / VPN / reverse proxy.
HOST=127.0.0.1
PORT=3888

# Admin Authentication
# Set a strong password for web dashboard access. If empty on first start, access requires setting password.
ADMIN_USERNAME=admin
# Leave empty to complete the loopback-only first-run setup in the dashboard.
# Alternatively, set a unique password of at least 12 characters before starting.
ADMIN_PASSWORD=
# Leave empty to generate an ephemeral secret on each process start, or set a stable
# random value of at least 32 UTF-8 bytes when persistent sessions are required.
SESSION_SECRET=

# Target Remote Server SSH Defaults (Optional initial values)
REMOTE_HOST=192.168.1.128
REMOTE_PORT=22
REMOTE_USER=root
# Enter SSH credentials through the dashboard; do not hardcode them in this file.

# SSH Host Key Security (TOFU / Known Hosts)
# Reconnect a saved SSH profile when the dashboard starts. Set false for maintenance or isolated testing.
# Optional known-hosts database path. Defaults to data/known_hosts.json.
# SSH_KNOWN_HOSTS_FILE=/secure/path/ssh-known-hosts.json
AUTO_CONNECT=true
SSH_STRICT_HOST_CHECK=true

# Initial setup is loopback-only by default. Enable temporarily only on a trusted network.
ALLOW_REMOTE_SETUP=false

# Express reverse-proxy trust. Keep false unless a known reverse proxy is in front.
TRUST_PROXY=false

# Security & Permissions
# Set to 'true' only if you explicitly trust users to run arbitrary shell commands via the scripts tab.
ENABLE_CUSTOM_SCRIPTS=false

# Allowed CORS Origins (comma-separated, e.g. https://admin.example.com). Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Model Management
# Comma-separated root directories scanned for GGUF/bin models
MODEL_ROOTS=/mnt/models,/opt/models
MODEL_SCAN_MAX_DEPTH=4

# Bind llama-server on the remote host. Loopback is accessed through the authenticated SSH tunnel.
LLM_BIND_HOST=127.0.0.1

# Hugging Face Access Token (Optional, for downloading gated models)
HF_TOKEN=

# System Telemetry Polling Interval (milliseconds)
METRICS_INTERVAL=2000

# Upload resource limits
MAX_UPLOAD_FILE_MB=512
MAX_UPLOAD_FILES=10

# Backpressure and connection limits (safe defaults)
PORT_FALLBACK_LIMIT=10
# Maximum graceful shutdown wait before active HTTP connections are closed (milliseconds)
SHUTDOWN_GRACE_MS=10000
# PBKDF2 login work: active 1-32, queued 0-256, queue timeout 100-30000 ms.
MAX_CONCURRENT_LOGIN_HASHES=4
MAX_QUEUED_LOGIN_HASHES=32
LOGIN_HASH_QUEUE_TIMEOUT_MS=2000
# SSH target switches are serialized; these bound waiting switch requests.
MAX_QUEUED_SSH_CONNECTIONS=8
SSH_CONNECTION_QUEUE_TIMEOUT_MS=30000
MAX_CONCURRENT_SSH_COMMANDS=12
MAX_QUEUED_SSH_COMMANDS=64
SSH_COMMAND_QUEUE_TIMEOUT_MS=10000
MAX_CONCURRENT_SFTP_CHANNELS=8
MAX_QUEUED_SFTP_OPERATIONS=32
SFTP_QUEUE_TIMEOUT_MS=10000
MAX_ACTIVE_MODEL_DOWNLOADS=4
MAX_TERMINAL_WEBSOCKETS=32
MAX_METRICS_WEBSOCKETS=64

# Safe archive extraction limits on the remote server
MAX_ARCHIVE_ENTRIES=10000
# Total expanded payload limit in MiB (default: 102400 / 100 GiB)
MAX_ARCHIVE_EXPANDED_MB=102400
